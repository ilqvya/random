@PACKAGE_INIT@
set_and_check(EFFOLKRONIUM_RANDOM_INCLUDE_DIR
 "@PACKAGE_EFFOLKRONIUM_RANDOM_INCLUDE_DESTINATION@")

include(${CMAKE_CURRENT_LIST_DIR}/effolkronium_randomTargets.cmake)

if(TARGET effolkronium_random AND NOT TARGET effolkronium::random)
    add_library(effolkronium::random ALIAS effolkronium_random)
endif()
if(TARGET effolkronium_random AND NOT TARGET ilqvya::random)
    add_library(ilqvya::random ALIAS effolkronium_random)
endif()