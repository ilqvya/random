@PACKAGE_INIT@
set_and_check(ILQVYA_RANDOM_INCLUDE_DIR
 "@PACKAGE_ILQVYA_RANDOM_INCLUDE_DESTINATION@")

include(${CMAKE_CURRENT_LIST_DIR}/ilqvya_randomTargets.cmake)

if(TARGET ilqvya::random AND NOT TARGET ilqvya_random)
    add_library(ilqvya_random ALIAS ilqvya::random)
endif()
if(TARGET ilqvya::random AND NOT TARGET effolkronium::random)
    add_library(effolkronium::random ALIAS ilqvya::random)
endif()
if(TARGET ilqvya::random AND NOT TARGET effolkronium_random)
    add_library(effolkronium_random ALIAS ilqvya::random)
endif()
if(TARGET ilqvya::random AND NOT TARGET random::random)
    add_library(random::random ALIAS ilqvya::random)
endif()